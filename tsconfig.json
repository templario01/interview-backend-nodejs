{
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "inlineSources": true,
    "moduleResolution": "node",
    "module": "es2020",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts"],
}
